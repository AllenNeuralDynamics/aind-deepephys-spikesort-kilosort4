#!/usr/bin/env bash
set -ex

# This is the master script for the capsule. When you click "Reproducible Run", the code in this file will execute.
if [[ "${1:-}" == "--score-diagnostic" ]]; then
	shift
	[[ -d ../data/full96_om1_probec_1200s ]]
	[[ -d ../data/probec_recording1_3 ]]
	python -u run_score_diagnostic.py
elif [[ "${1:-}" == "--score-diagnostic-raw-native" ]]; then
	shift
	[[ -d ../data/probec_recording1_3 ]]
	python -u run_raw_native_score_diagnostic.py
elif [[ "${1:-}" == "--target-decoy-diagnostic" ]]; then
	shift
	[[ -d ../data/full96_om1_probec_1200s ]]
	[[ -d ../data/probec_recording1_3 ]]
	python -u run_target_decoy_diagnostic.py "$@"
elif [[ "${1:-}" == "--joint-refit-diagnostic" ]]; then
	shift
	[[ -d ../data/full96_om1_probec_1200s ]]
	[[ -d ../data/probec_recording1_3 ]]
	python -u run_joint_refit_diagnostic.py "$@"
elif [[ "${1:-}" == "--peel-stopping-diagnostic" ]]; then
	shift
	[[ -d ../data/full96_om1_probec_1200s ]]
	[[ -d ../data/probec_recording1_3 ]]
	python -u run_peel_stopping_diagnostic.py "$@"
else
	python -u run_capsule.py "$@"
fi
